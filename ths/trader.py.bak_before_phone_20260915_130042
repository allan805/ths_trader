    @timer
    def get_orders(self, order_type: str = "today") -> Dict[str, Any]:
        """
        获取委托记录。

        当前同花顺委托行实际格式：

        股票名称
        委托时间
        委托价格
        成交价格
        委托数量
        成交数量
        买卖方向
        委托状态

        例如：

        宝泰隆
        10:16:52
        3.020
        0.000
        300
        0
        卖出
        订单已报
        """
        result = {
            "success": False,
            "mode": self.trade_mode,
            "orders": [],
            "screenshot": None
        }

        try:
            if not self.go_to_trade():
                raise Exception("无法进入交易页面")

            # 进入查询
            if not self.click_by_text("查询", timeout=5):
                if not self.click_by_text("委托查询", timeout=3):
                    raise Exception("无法找到查询按钮")

            self.wait(2)

            # 查询类型
            if order_type == "today":
                if not self.click_by_text("当日委托", timeout=3):
                    logger.warning("未找到“当日委托”，继续读取当前页面")
            elif order_type == "history":
                if not self.click_by_text("历史委托", timeout=3):
                    logger.warning("未找到“历史委托”，继续读取当前页面")

            self.wait(2)

            result["screenshot"] = self.screenshot(
                f"orders_{order_type}.png"
            )

            import xml.etree.ElementTree as ET

            hierarchy = self.d.dump_hierarchy()
            root = ET.fromstring(hierarchy)

            containers = []

            for node in root.iter():
                cls = node.attrib.get("class", "")

                if cls in (
                    "androidx.recyclerview.widget.RecyclerView",
                    "android.widget.ListView"
                ):
                    containers.append(node)

            orders = []

            for container in containers:

                for child in list(container):

                    texts = []

                    for node in child.iter():

                        if node.attrib.get("class") == "android.widget.TextView":

                            text = node.attrib.get("text", "").strip()

                            if text and text not in texts:
                                texts.append(text)

                    # 当前委托记录至少 8 个字段
                    if len(texts) < 8:
                        continue

                    # ==================================================
                    # 当前同花顺委托行：
                    #
                    # [0] 股票名称
                    # [1] 时间
                    # [2] 委托价格
                    # [3] 成交价格
                    # [4] 委托数量
                    # [5] 成交数量
                    # [6] 买卖方向
                    # [7] 委托状态
                    # ==================================================

                    name = texts[0]
                    order_time = texts[1]
                    order_price = texts[2]
                    deal_price = texts[3]
                    order_quantity = texts[4]
                    deal_quantity = texts[5]
                    direction = texts[6]
                    status = texts[7]

                    # 股票名称不能是功能按钮
                    if name in {
                        "查询",
                        "撤单",
                        "持仓",
                        "买入",
                        "卖出",
                        "添加笔记",
                        "当日委托",
                        "历史委托"
                    }:
                        continue

                    # 委托价格 / 成交价格
                    if not re.match(
                        r"^-?[\d,]+\.\d+$",
                        order_price
                    ):
                        continue

                    if not re.match(
                        r"^-?[\d,]+\.\d+$",
                        deal_price
                    ):
                        continue

                    # 委托数量 / 成交数量
                    if not re.match(r"^\d+$", order_quantity):
                        continue

                    if not re.match(r"^\d+$", deal_quantity):
                        continue

                    # 买卖方向
                    if direction not in ("买入", "卖出"):
                        continue

                    order = {
                        "name": name,
                        "time": order_time,
                        "order_price": order_price.replace(",", ""),
                        "deal_price": deal_price.replace(",", ""),
                        "order_quantity": order_quantity,
                        "deal_quantity": deal_quantity,
                        "direction": direction,
                        "status": status,

                        # 保留原始数据，方便以后排查
                        "raw": " ".join(texts),
                        "details": texts
                    }

                    orders.append(order)

                    logger.info(f"✅ 识别到委托: {order}")

            result["orders"] = orders
            result["success"] = True

            logger.info(
                f"✅ 获取到 {len(orders)} 条{order_type}委托记录"
            )

            self.back_to_trade_main()

        except Exception as e:

            logger.error(f"获取委托记录失败: {e}")

            result["error"] = str(e)

            result["screenshot"] = self.screenshot(
                f"orders_{order_type}_error.png"
            )

        return result

