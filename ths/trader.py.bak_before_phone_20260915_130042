    # ==================== 交易操作 ====================

    def _get_visible_texts(self) -> List[str]:
        """快速获取当前页面所有可见文本。"""
        texts = []
        try:
            count = self.d(className="android.widget.TextView").count
            for i in range(count):
                try:
                    tv = self.d(className="android.widget.TextView", instance=i)
                    if tv.exists:
                        text = tv.get_text()
                        if text and text.strip():
                            texts.append(text.strip())
                except Exception:
                    pass
        except Exception as e:
            logger.warning(f"获取当前页面文本失败: {e}")
        return texts

    def _detect_trade_message(self, texts: List[str]) -> Optional[str]:
        """识别同花顺交易过程中的明确成功/失败提示。"""
        joined = " ".join(texts)

        # 明确失败关键词
        failure_patterns = [
            "资金不足",
            "可用资金不足",
            "资金余额不足",
            "可用余额不足",
            "持仓不足",
            "可用数量不足",
            "可卖数量不足",
            "数量不足",
            "价格错误",
            "价格超出",
            "价格异常",
            "数量错误",
            "委托失败",
            "下单失败",
            "申报失败",
            "提交失败",
            "交易失败",
            "操作失败",
            "委托被拒绝",
            "申报被拒绝",
            "风险提示",
            "风险警示",
            "禁止交易",
            "无法交易",
            "不允许交易",
        ]

        for pattern in failure_patterns:
            if pattern in joined:
                return pattern

        return None

    def _find_trade_success_message(self, texts: List[str]) -> bool:
        """判断页面是否出现明确的提交成功提示。"""
        joined = " ".join(texts)

        success_patterns = [
            "委托成功",
            "委托已报",
            "已报",
            "申报成功",
            "申报已报",
            "提交成功",
            "下单成功",
            "订单已报",
        ]

        return any(x in joined for x in success_patterns)

    def _wait_trade_result(self, seconds: float = 3.0) -> Dict[str, Any]:
        """
        等待交易结果并读取页面。
        注意：这里只判断UI反馈，不直接认为已经成交。
        """
        deadline = time.time() + seconds
        last_texts = []

        while time.time() < deadline:
            last_texts = self._get_visible_texts()

            error = self._detect_trade_message(last_texts)
            if error:
                return {
                    "success": False,
                    "message": error,
                    "texts": last_texts
                }

            if self._find_trade_success_message(last_texts):
                return {
                    "success": True,
                    "message": "检测到委托成功/已报提示",
                    "texts": last_texts
                }

            time.sleep(0.5)

        return {
            "success": False,
            "message": None,
            "texts": last_texts
        }

    def _validate_order_params(
        self,
        code: str,
        price: Optional[str],
        quantity: str,
        side: str
    ) -> None:
        """交易参数本地预检查，避免明显错误直接进入实盘。"""
        if not code or not re.fullmatch(r"\d{6}", str(code)):
            raise ValueError(f"股票代码必须是6位数字: {code}")

        try:
            qty = int(str(quantity))
        except Exception:
            raise ValueError(f"数量必须是整数: {quantity}")

        if qty <= 0:
            raise ValueError(f"数量必须大于0: {quantity}")

        # A股买入/卖出普通股票通常要求100股整数倍。
        # 这里不强制所有品种都如此，避免误伤特殊品种。
        if qty % 100 != 0:
            logger.warning(
                f"{side}数量 {qty} 不是100股整数倍，交给券商/同花顺最终校验"
            )

        if price is not None and str(price).strip() != "":
            try:
                if float(price) <= 0:
                    raise ValueError(f"价格必须大于0: {price}")
            except ValueError:
                raise
            except Exception:
                raise ValueError(f"价格格式错误: {price}")

    def _verify_order_in_today_orders(
        self,
        code: str,
        side: str,
        quantity: str,
        price: Optional[str]
    ) -> Dict[str, Any]:
        """
        下单后通过“当日委托”再次验证。
        注意：这里验证的是“委托是否产生”，不是“是否成交”。
        """
        result = {
            "verified": False,
            "matched_order": None,
            "orders": []
        }

        try:
            orders_result = self.get_orders("today")

            if not orders_result.get("success"):
                result["error"] = "查询当日委托失败"
                return result

            orders = orders_result.get("orders", [])
            result["orders"] = orders

            target_qty = str(quantity)
            target_price = None if price is None or str(price).strip() == "" else str(price)

            # 最新委托通常在列表前面。
            for order in orders:
                order_side = str(order.get("direction", ""))
                order_qty = str(order.get("order_quantity", ""))
                order_price = str(order.get("order_price", ""))

                if side == "buy" and "买" not in order_side:
                    continue
                if side == "sell" and "卖" not in order_side:
                    continue

                if order_qty != target_qty:
                    continue

                if target_price is not None:
                    try:
                        if abs(float(order_price) - float(target_price)) > 0.0001:
                            continue
                    except Exception:
                        continue

                result["verified"] = True
                result["matched_order"] = order
                return result

            return result

        except Exception as e:
            result["error"] = str(e)
            logger.warning(f"验证当日委托失败: {e}")
            return result

    def _execute_order(
        self,
        side: str,
        code: str,
        price: Optional[str],
        quantity: str,
        mode: Optional[str] = None
    ) -> Dict[str, Any]:
        """
        统一买卖下单流程。

        success:
            整个交易操作最终是否成功确认。

        submitted:
            是否确认已经进入当日委托。

        filled:
            是否确认成交。
            本方法不直接假设成交，默认 False。
        """
        if mode:
            if mode not in ("simulate", "real"):
                raise ValueError(f"不支持的交易模式: {mode}")
            if not self.set_trade_mode(mode):
                raise Exception(f"无法切换到交易模式: {mode}")

        self._validate_order_params(code, price, quantity, side)

        side_name = "买入" if side == "buy" else "卖出"

        result = {
            "success": False,
            "submitted": False,
            "filled": False,
            "mode": self.trade_mode,
            "side": side,
            "code": str(code),
            "price": price,
            "quantity": str(quantity),
            "steps": [],
            "error": None,
            "trade_message": None,
            "order": None,
            "screenshot": None,
            "timestamp": datetime.now().isoformat()
        }

        try:
            # --------------------------------------------------
            # 1. 进入交易页面
            # --------------------------------------------------
            result["steps"].append("进入交易页面")

            if not self.go_to_trade():
                raise Exception("无法进入交易页面")

            # --------------------------------------------------
            # 2. 点击买入/卖出
            # --------------------------------------------------
            result["steps"].append(f"点击{side_name}")

            if not self.click_by_text(side_name, timeout=5):
                if not self.click_by_xpath(f'//*[@text="{side_name}"]'):
                    raise Exception(f"无法点击{side_name}")

            self.wait(1)

            # --------------------------------------------------
            # 3. 输入股票代码
            # --------------------------------------------------
            result["steps"].append("输入股票代码")

            if not self.click_by_text("股票代码/简拼", timeout=5):
                self.click_by_xpath('//*[@text="股票代码/简拼"]')

            self.wait(0.5)

            if not self.input_text(code, 0):
                raise Exception("无法输入股票代码")

            self.wait(1)

            # 选择搜索结果
            self.click_search_stock(1)
            self.wait(1)

            # --------------------------------------------------
            # 4. 输入价格
            # --------------------------------------------------
            result["steps"].append("输入价格")

            if price is not None and str(price).strip() != "":
                if not self.input_text(str(price), 1):
                    raise Exception("无法输入价格")

            # --------------------------------------------------
            # 5. 输入数量
            # --------------------------------------------------
            result["steps"].append("输入数量")

            if not self.input_text(str(quantity), 2):
                raise Exception("无法输入数量")

            self.wait(0.5)

            # --------------------------------------------------
            # 6. 点击最终下单按钮
            # --------------------------------------------------
            result["steps"].append(f"确认{side_name}")

            clicked = False

            if side == "buy":
                if self.trade_mode == "simulate":
                    clicked = self.click_by_text("买 入(模拟炒股)", timeout=3)
                else:
                    clicked = (
                        self.click_by_text("买 入", timeout=3)
                        or self.click_by_text("确定", timeout=3)
                    )
            else:
                if self.trade_mode == "simulate":
                    clicked = self.click_by_text("卖 出(模拟炒股)", timeout=3)
                else:
                    clicked = self.click_by_text("卖 出", timeout=3)

            if not clicked:
                raise Exception(f"无法点击最终{side_name}按钮")

            # --------------------------------------------------
            # 7. 等待并识别结果
            # --------------------------------------------------
            self.wait(1)

            result["steps"].append("等待交易结果")

            trade_result = self._wait_trade_result(5)

            result["trade_message"] = trade_result.get("message")

            if trade_result.get("message"):
                logger.info(
                    f"{side_name}页面反馈: {trade_result.get('message')}"
                )

            # 截图保留现场
            result["screenshot"] = self.screenshot(
                f"{side}_{code}_{datetime.now().strftime('%H%M%S')}.png"
            )

            # --------------------------------------------------
            # 8. 明确失败
            # --------------------------------------------------
            if not trade_result.get("success"):
                # 特别重要：
                # 页面没有明确成功，也不能认为下单成功。
                texts = trade_result.get("texts", [])

                error = self._detect_trade_message(texts)

                if error:
                    result["error"] = error
                else:
                    result["error"] = (
                        f"未检测到明确的{side_name}成功反馈"
                    )

                logger.warning(
                    f"❌ {side_name}未确认成功: {result['error']}"
                )

                return result

            # --------------------------------------------------
            # 9. 查询当日委托进行二次确认
            # --------------------------------------------------
            result["steps"].append("查询当日委托验证")

            self.wait(1)

            verify = self._verify_order_in_today_orders(
                code=code,
                side=side,
                quantity=quantity,
                price=price
            )

            if verify.get("verified"):
                result["submitted"] = True
                result["order"] = verify.get("matched_order")
                result["success"] = True

                # 订单进入委托 ≠ 成交
                matched = verify.get("matched_order") or {}

                deal_qty = str(matched.get("deal_quantity", "0"))

                if deal_qty.isdigit() and int(deal_qty) > 0:
                    result["filled"] = True

                logger.info(
                    f"✅ {side_name}已确认进入当日委托: "
                    f"{matched}"
                )
            else:
                result["error"] = (
                    "页面提示成功，但在当日委托中未找到对应订单，"
                    "因此不认为下单成功"
                )

                logger.error(
                    f"❌ {side_name}二次验证失败: "
                    f"未找到对应委托"
                )

            return result

        except Exception as e:
            result["error"] = str(e)
            logger.error(f"❌ {side_name}异常: {e}")

            result["screenshot"] = self.screenshot(
                f"{side}_{code}_error_{datetime.now().strftime('%H%M%S')}.png"
            )

            return result

        finally:
            # 尽量退出当前下单页面，但不要覆盖交易结果。
            try:
                self.back_from_buy()
            except Exception as e:
                logger.warning(f"返回交易页面失败: {e}")

