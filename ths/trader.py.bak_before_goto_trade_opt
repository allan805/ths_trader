    def click_search_stock(self, num):
        """
        点击股票搜索结果。

        num 从 1 开始：
            1 = 第一个搜索结果
            2 = 第二个搜索结果
            3 = 第三个搜索结果

        返回：
            True  = 成功点击
            False = 没有找到对应搜索结果
        """
        try:
            num = int(num)
        except (TypeError, ValueError):
            logger.error(f"搜索结果序号无效: {num}")
            return False

        if num < 1:
            logger.error(f"搜索结果序号必须 >= 1: {num}")
            return False

        self.wait(2)

        logger.info(f"点击搜索结果中的第 {num} 个股票")

        all_texts = []

        try:
            count = self.d(
                className="android.widget.TextView"
            ).count

            for i in range(count):
                try:
                    tv = self.d(
                        className="android.widget.TextView",
                        instance=i
                    )

                    if tv.exists:
                        text = tv.get_text()

                        if text and text.strip():
                            all_texts.append(text.strip())

                except Exception as e:
                    logger.warning(
                        f"读取搜索结果文本失败 instance={i}: {e}"
                    )

        except Exception as e:
            logger.error(f"获取搜索结果失败: {e}")
            return False

        logger.info(f"当前页面文本: {all_texts}")

        # 找到“搜索结果”所在位置
        search_result_index = None

        for i, text in enumerate(all_texts):
            if "搜索结果" in text:
                search_result_index = i
                break

        if search_result_index is None:
            logger.warning("❌ 没有找到“搜索结果”")
            return False

        # 当前同花顺搜索结果通常从“搜索结果”之后开始。
        target_index = search_result_index + num

        if target_index >= len(all_texts):
            logger.warning(
                f"❌ 没有第 {num} 个搜索结果，"
                f"搜索结果总文本数不足"
            )
            return False

        target_text = all_texts[target_index].strip()

        if not target_text:
            logger.warning(
                f"❌ 第 {num} 个搜索结果文本为空"
            )
            return False

        logger.info(
            f"🎯 准备点击第 {num} 个搜索结果: {target_text}"
        )

        # 防止误把其它功能文字当股票结果
        invalid_texts = {
            "搜索结果",
            "股票代码",
            "股票名称",
            "取消",
            "确定",
            "查询",
            "买入",
            "卖出",
            "持仓",
            "撤单"
        }

        if target_text in invalid_texts:
            logger.error(
                f"❌ 第 {num} 个搜索结果疑似不是股票: {target_text}"
            )
            return False

        if not self.click_by_text(target_text, timeout=3):
            logger.error(
                f"❌ 点击搜索结果失败: {target_text}"
            )
            return False

        self.wait(1)

        logger.info(
            f"✅ 已点击第 {num} 个搜索结果: {target_text}"
        )

        return True




    def _verify_stock_selection(
        self,
        code: str,
        timeout: float = 5.0
    ) -> bool:
        """
        验证同花顺是否已经正确识别输入的股票/转债。

        当前手机真实 UI：

        auto_stockcode -> 股票/转债代码
        stockname      -> 股票/转债名称

        输入代码后，同花顺会自动完成匹配，
        不需要再点击“搜索结果”。

        本函数只验证，不执行任何交易。
        """
        expected_code = str(code).strip()

        if not expected_code:
            logger.error("❌ 股票代码为空")
            return False

        deadline = time.time() + timeout

        last_code = ""
        last_name = ""

        while time.time() < deadline:
            try:
                code_obj = self.d(
                    resourceId="com.hexin.plat.android:id/auto_stockcode"
                )

                name_obj = self.d(
                    resourceId="com.hexin.plat.android:id/stockname"
                )

                if code_obj.exists:
                    actual_code = (
                        code_obj.get_text() or ""
                    ).strip()
                else:
                    actual_code = ""

                if name_obj.exists:
                    stock_name = (
                        name_obj.get_text() or ""
                    ).strip()
                else:
                    stock_name = ""

                last_code = actual_code
                last_name = stock_name

                logger.info(
                    f"🔎 股票识别状态: "
                    f"输入={expected_code}, "
                    f"代码={actual_code}, "
                    f"名称={stock_name}"
                )

                # 必须代码完全一致
                if actual_code != expected_code:
                    time.sleep(0.3)
                    continue

                # 名称不能为空
                if not stock_name:
                    time.sleep(0.3)
                    continue

                logger.info(
                    f"✅ 股票识别验证成功: "
                    f"{expected_code} -> {stock_name}"
                )

                return True

            except Exception as e:
                logger.warning(
                    f"读取股票识别结果失败: {e}"
                )

            time.sleep(0.3)

        logger.error(
            f"❌ 股票识别验证失败: "
            f"期望代码={expected_code}, "
            f"实际代码={last_code}, "
            f"股票名称={last_name}"
        )

        return False


