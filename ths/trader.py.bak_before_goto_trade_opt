    def _get_visible_texts(self) -> List[str]:
        """快速获取当前页面所有可见文本。"""
        texts = []
        try:
            count = self.d(className="android.widget.TextView").count
            for i in range(count):
                try:
                    tv = self.d(className="android.widget.TextView", instance=i)
                    if tv.exists:
                        text = tv.get_text()
                        if text and text.strip():
                            texts.append(text.strip())
                except Exception:
                    pass
        except Exception as e:
            logger.warning(f"获取当前页面文本失败: {e}")
        return texts

    def _detect_trade_message(self, texts: List[str]) -> Optional[str]:
        """识别同花顺交易过程中的明确成功/失败提示。"""
        joined = " ".join(texts)

        # 明确失败关键词
        failure_patterns = [
            "资金不足",
            "可用资金不足",
            "资金余额不足",
            "可用余额不足",
            "持仓不足",
            "可用数量不足",
            "可卖数量不足",
            "数量不足",
            "价格错误",
            "价格超出",
            "价格异常",
            "数量错误",
            "委托失败",
            "下单失败",
            "申报失败",
            "提交失败",
            "交易失败",
            "操作失败",
            "委托被拒绝",
            "申报被拒绝",
            "风险提示",
            "风险警示",
            "禁止交易",
            "无法交易",
            "不允许交易",
        ]

        for pattern in failure_patterns:
            if pattern in joined:
                return pattern

        return None

    def _find_trade_success_message(self, texts: List[str]) -> bool:
        """判断页面是否出现明确的提交成功提示。"""
        joined = " ".join(texts)

        success_patterns = [
            "委托成功",
            "委托已报",
            "已报",
            "申报成功",
            "申报已报",
            "提交成功",
            "下单成功",
            "订单已报",
        ]

        return any(x in joined for x in success_patterns)

    def _wait_trade_result(self, seconds: float = 3.0) -> Dict[str, Any]:
        """
        等待交易结果并读取页面。
        注意：这里只判断UI反馈，不直接认为已经成交。
        """
        deadline = time.time() + seconds
        last_texts = []

        while time.time() < deadline:
            last_texts = self._get_visible_texts()

            error = self._detect_trade_message(last_texts)
            if error:
                return {
                    "success": False,
                    "message": error,
                    "texts": last_texts
                }

            if self._find_trade_success_message(last_texts):
                return {
                    "success": True,
                    "message": "检测到委托成功/已报提示",
                    "texts": last_texts
                }

            time.sleep(0.5)

        return {
            "success": False,
            "message": None,
            "texts": last_texts
        }

    def _validate_order_params(
        self,
        code: str,
        price: Optional[str],
        quantity: str,
        side: str
    ) -> None:
        """交易参数本地预检查，避免明显错误直接进入实盘。"""
        if not code or not re.fullmatch(r"\d{6}", str(code)):
            raise ValueError(f"股票代码必须是6位数字: {code}")

        try:
            qty = int(str(quantity))
        except Exception:
            raise ValueError(f"数量必须是整数: {quantity}")

        if qty <= 0:
            raise ValueError(f"数量必须大于0: {quantity}")

        # A股买入/卖出普通股票通常要求100股整数倍。
        # 这里不强制所有品种都如此，避免误伤特殊品种。
        if qty % 100 != 0:
            logger.warning(
                f"{side}数量 {qty} 不是100股整数倍，交给券商/同花顺最终校验"
            )

        if price is not None and str(price).strip() != "":
            try:
                if float(price) <= 0:
                    raise ValueError(f"价格必须大于0: {price}")
            except ValueError:
                raise
            except Exception:
                raise ValueError(f"价格格式错误: {price}")




    def _verify_order_in_today_orders(
        self,
        code: str,
        side: str,
        quantity: str,
        price: Optional[str]
    ) -> Dict[str, Any]:
        """
        下单后通过“当日委托”验证是否产生了新的委托。

        重要：
        当前同花顺委托列表实际没有股票代码字段，
        因此不能凭空使用 code 与委托记录比较。

        本方法采用：

            下单前委托快照
                  ↓
            执行买/卖
                  ↓
            下单后委托列表
                  ↓
            找新增委托
                  ↓
            买卖方向 + 数量 + 价格验证

        success / verified 表示：
            已确认产生新的对应委托。

        注意：
            “委托成功” != “成交成功”
        """

        result = {
            "verified": False,
            "matched_order": None,
            "orders": [],
            "new_orders": [],
            "error": None
        }

        try:
            # --------------------------------------------------
            # 1. 获取下单后的当日委托
            # --------------------------------------------------
            orders_result = self.get_orders("today")

            if not orders_result.get("success"):
                result["error"] = "查询当日委托失败"
                return result

            orders = orders_result.get("orders", [])
            result["orders"] = orders

            # --------------------------------------------------
            # 2. 获取下单前快照
            #
            # _execute_order() 会在真正下单前保存：
            #
            # self._order_snapshot_before
            # --------------------------------------------------
            before_orders = getattr(
                self,
                "_order_snapshot_before",
                []
            )

            logger.info(
                f"下单前委托数量: {len(before_orders)}"
            )

            logger.info(
                f"下单后委托数量: {len(orders)}"
            )

            # --------------------------------------------------
            # 3. 找出“新增”的委托
            #
            # 不能简单使用 set，因为同样的委托可能重复出现。
            # 这里采用“逐条消耗”方式。
            # --------------------------------------------------
            remaining_before = list(before_orders)
            new_orders = []

            for order in orders:
                matched_old_index = None

                for i, old_order in enumerate(remaining_before):

                    same = (
                        str(order.get("name", "")) ==
                        str(old_order.get("name", ""))
                        and
                        str(order.get("time", "")) ==
                        str(old_order.get("time", ""))
                        and
                        str(order.get("order_price", "")) ==
                        str(old_order.get("order_price", ""))
                        and
                        str(order.get("deal_price", "")) ==
                        str(old_order.get("deal_price", ""))
                        and
                        str(order.get("order_quantity", "")) ==
                        str(old_order.get("order_quantity", ""))
                        and
                        str(order.get("deal_quantity", "")) ==
                        str(old_order.get("deal_quantity", ""))
                        and
                        str(order.get("direction", "")) ==
                        str(old_order.get("direction", ""))
                        and
                        str(order.get("status", "")) ==
                        str(old_order.get("status", ""))
                    )

                    if same:
                        matched_old_index = i
                        break

                if matched_old_index is not None:
                    # 这是下单前已经存在的委托
                    remaining_before.pop(matched_old_index)
                else:
                    # 这是下单后新增的委托
                    new_orders.append(order)

            result["new_orders"] = new_orders

            logger.info(
                f"📋 检测到新增委托 {len(new_orders)} 条"
            )

            for order in new_orders:
                logger.info(
                    f"🆕 新委托: {order}"
                )

            # --------------------------------------------------
            # 4. 如果没有新增委托，直接失败
            # --------------------------------------------------
            if not new_orders:
                result["error"] = (
                    "下单后未发现新增委托，"
                    "因此不认为下单成功"
                )

                logger.error(
                    f"❌ 未发现新增委托: "
                    f"code={code}, side={side}, "
                    f"quantity={quantity}, price={price}"
                )

                return result

            # --------------------------------------------------
            # 5. 验证方向
            # --------------------------------------------------
            expected_direction = (
                "买入" if side == "buy" else "卖出"
            )

            target_qty = str(quantity).strip()

            target_price = None

            if price is not None:
                price_text = str(price).strip()

                if price_text:
                    try:
                        target_price = float(price_text)
                    except ValueError:
                        target_price = None

            # --------------------------------------------------
            # 6. 在新增委托中寻找匹配项
            # --------------------------------------------------
            for order in new_orders:

                order_direction = str(
                    order.get("direction", "")
                ).strip()

                order_quantity = str(
                    order.get("order_quantity", "")
                ).strip()

                order_price = str(
                    order.get("order_price", "")
                ).strip()

                # 方向
                if order_direction != expected_direction:
                    continue

                # 数量
                if order_quantity != target_qty:
                    continue

                # 价格
                #
                # price=None 表示调用方没有指定价格，
                # 这种情况下不比较价格。
                if target_price is not None:
                    try:
                        actual_price = float(order_price)

                        if abs(actual_price - target_price) > 0.0001:
                            continue

                    except Exception:
                        continue

                # --------------------------------------------------
                # 找到符合条件的“新增委托”
                # --------------------------------------------------
                result["verified"] = True
                result["matched_order"] = order

                logger.info(
                    f"✅ 新委托验证成功: {order}"
                )

                return result

            # --------------------------------------------------
            # 7. 有新增委托，但没有匹配方向/数量/价格
            # --------------------------------------------------
            result["error"] = (
                "检测到了新增委托，但没有找到与本次交易"
                "方向、数量、价格匹配的委托"
            )

            logger.error(
                f"❌ 新增委托存在，但参数不匹配: "
                f"code={code}, side={side}, "
                f"quantity={quantity}, price={price}"
            )

            return result

        except Exception as e:

            result["error"] = str(e)

            logger.exception(
                f"验证当日委托异常: {e}"
            )

            return result


    def _execute_order(
        self,
        side: str,
        code: str,
        price: Optional[str],
        quantity: str,
        mode: Optional[str] = None
    ) -> Dict[str, Any]:
        """
        统一买卖下单流程。

        success:
            已确认产生新的当日委托。

        submitted:
            已确认产生新的当日委托。

        filled:
            当日委托中的成交数量 > 0。

        注意：
            点击下单按钮 != 下单成功
            页面提示成功 != 委托一定产生
            委托产生 != 已成交
        """

        if mode:
            if mode not in ("simulate", "real"):
                raise ValueError(
                    f"不支持的交易模式: {mode}"
                )

            if not self.set_trade_mode(mode):
                raise Exception(
                    f"无法切换到交易模式: {mode}"
                )

        self._validate_order_params(
            code,
            price,
            quantity,
            side
        )

        side_name = "买入" if side == "buy" else "卖出"

        result = {
            "success": False,
            "submitted": False,
            "filled": False,
            "mode": self.trade_mode,
            "side": side,
            "code": str(code),
            "price": price,
            "quantity": str(quantity),
            "steps": [],
            "error": None,
            "trade_message": None,
            "order": None,
            "new_orders": [],
            "screenshot": None,
            "timestamp": datetime.now().isoformat()
        }

        try:
            # ==================================================
            # 1. 进入交易页面
            # ==================================================
            result["steps"].append("进入交易页面")

            if not self.go_to_trade():
                raise Exception("无法进入交易页面")

            # ==================================================
            # 2. 下单前保存当日委托快照
            # ==================================================
            result["steps"].append("保存下单前委托快照")

            before_result = self.get_orders("today")

            if not before_result.get("success"):
                raise Exception(
                    "无法获取下单前当日委托，为安全起见停止下单"
                )

            self._order_snapshot_before = list(
                before_result.get("orders", [])
            )

            logger.info(
                f"📋 下单前已有 "
                f"{len(self._order_snapshot_before)} 条委托"
            )

            # get_orders() 会返回交易主页面
            if not self.go_to_trade():
                raise Exception(
                    "保存委托快照后无法返回交易页面"
                )

            # ==================================================
            # 3. 点击买入 / 卖出
            # ==================================================
            result["steps"].append(f"点击{side_name}")

            clicked = self.click_by_text(
                side_name,
                timeout=5
            )

            if not clicked:
                clicked = self.click_by_xpath(
                    f'//*[@text="{side_name}"]'
                )

            if not clicked:
                raise Exception(
                    f"无法点击{side_name}"
                )

            self.wait(1)

            # ==================================================
            # 4. 输入股票代码
            # ==================================================
            result["steps"].append("输入股票代码")

            # 当前同花顺真实 UI：
            # resource-id = com.hexin.plat.android:id/auto_stockcode
            # hint       = 股票代码/简拼
            #
            # “股票代码/简拼”是 hint，不是可靠的 text，
            # 因此直接使用 resource-id 定位。

            code_input = self.d(
                resourceId=(
                    "com.hexin.plat.android:id/"
                    "auto_stockcode"
                )
            )

            if not code_input.exists:
                raise Exception(
                    "无法找到股票代码输入框: "
                    "com.hexin.plat.android:id/auto_stockcode"
                )

            try:
                code_input.click()
            except Exception as e:
                raise Exception(
                    f"无法点击股票代码输入框: {e}"
                )

            clicked_code = True

            self.wait(0.5)

            if not self.input_text(str(code), 0):
                raise Exception(
                    "无法输入股票代码"
                )

            self.wait(1)

            # ==================================================
            # 5. 验证股票代码和股票名称
            # ==================================================
            result["steps"].append(
                "验证股票代码和股票名称"
            )

            if not self._verify_stock_selection(str(code)):
                raise Exception(
                    f"股票代码识别失败: {code}"
                )

            self.wait(1)

            # ==================================================
            # 6. 输入价格
            # ==================================================
            result["steps"].append("输入价格")

            if (
                price is not None
                and str(price).strip() != ""
            ):
                if not self.input_text(
                    str(price),
                    1
                ):
                    raise Exception(
                        "无法输入价格"
                    )

            # ==================================================
            # 7. 输入数量
            # ==================================================
            result["steps"].append("输入数量")

            if not self.input_text(
                str(quantity),
                2
            ):
                raise Exception(
                    "无法输入数量"
                )

            self.wait(0.5)

            # ==================================================
            # 8. 点击最终下单按钮
            # ==================================================
            result["steps"].append(
                f"确认{side_name}"
            )

            clicked = False

            if side == "buy":
                if self.trade_mode == "simulate":
                    clicked = self.click_by_text(
                        "买 入(模拟炒股)",
                        timeout=3
                    )
                else:
                    clicked = (
                        self.click_by_text(
                            "买 入",
                            timeout=3
                        )
                        or
                        self.click_by_text(
                            "确定",
                            timeout=3
                        )
                    )

            else:
                if self.trade_mode == "simulate":
                    clicked = self.click_by_text(
                        "卖 出(模拟炒股)",
                        timeout=3
                    )
                else:
                    clicked = self.click_by_text(
                        "卖 出",
                        timeout=3
                    )

            if not clicked:
                raise Exception(
                    f"无法点击最终{side_name}按钮"
                )

            # ==================================================
            # 9. 等待交易结果
            # ==================================================
            result["steps"].append(
                "等待交易结果"
            )

            self.wait(1)

            trade_result = self._wait_trade_result(5)

            result["trade_message"] = (
                trade_result.get("message")
            )

            if trade_result.get("message"):
                logger.info(
                    f"{side_name}页面反馈: "
                    f"{trade_result.get('message')}"
                )

            # ==================================================
            # 10. 保存截图
            # ==================================================
            result["screenshot"] = self.screenshot(
                f"{side}_{code}_"
                f"{datetime.now().strftime('%H%M%S')}.png"
            )

            # ==================================================
            # 11. 页面明确失败
            # ==================================================
            if not trade_result.get("success"):

                texts = trade_result.get(
                    "texts",
                    []
                )

                error = self._detect_trade_message(
                    texts
                )

                if error:
                    result["error"] = error
                else:
                    result["error"] = (
                        f"未检测到明确的"
                        f"{side_name}成功反馈"
                    )

                logger.warning(
                    f"❌ {side_name}未确认成功: "
                    f"{result['error']}"
                )

                return result

            # ==================================================
            # 12. 查询当日委托二次确认
            # ==================================================
            result["steps"].append(
                "查询当日委托验证"
            )

            self.wait(1)

            verify = self._verify_order_in_today_orders(
                code=code,
                side=side,
                quantity=quantity,
                price=price
            )

            result["new_orders"] = verify.get(
                "new_orders",
                []
            )

            # ==================================================
            # 13. 确认产生新的委托
            # ==================================================
            if verify.get("verified"):

                result["submitted"] = True
                result["success"] = True

                result["order"] = verify.get(
                    "matched_order"
                )

                matched = verify.get(
                    "matched_order"
                ) or {}

                deal_qty_text = str(
                    matched.get(
                        "deal_quantity",
                        "0"
                    )
                ).replace(",", "").strip()

                try:
                    deal_qty = int(
                        float(deal_qty_text)
                    )
                except Exception:
                    deal_qty = 0

                if deal_qty > 0:
                    result["filled"] = True

                logger.info(
                    f"✅ {side_name}已确认产生新委托: "
                    f"{matched}"
                )

                if result["filled"]:
                    logger.info(
                        f"✅ {side_name}当前已发现成交数量: "
                        f"{deal_qty}"
                    )
                else:
                    logger.info(
                        f"ℹ️ {side_name}已委托，"
                        f"当前成交数量为 0"
                    )

            else:

                result["error"] = (
                    verify.get("error")
                    or
                    "页面提示成功，但在下单前后"
                    "委托对比中没有找到对应新增委托，"
                    "因此不认为下单成功"
                )

                logger.error(
                    f"❌ {side_name}二次验证失败: "
                    f"{result['error']}"
                )

            return result

        except Exception as e:

            result["error"] = str(e)

            logger.exception(
                f"❌ {side_name}异常: {e}"
            )

            result["screenshot"] = self.screenshot(
                f"{side}_{code}_error_"
                f"{datetime.now().strftime('%H%M%S')}.png"
            )

            return result

        finally:

            try:
                self._order_snapshot_before = []
            except Exception:
                pass

            try:
                if side == "buy":
                    self.back_from_buy()
                else:
                    self.back_from_sell()
            except Exception as e:
                logger.warning(
                    f"返回交易页面失败: {e}"
                )


